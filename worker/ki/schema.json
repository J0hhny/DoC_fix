{
  "type": "object",
  "properties": {
    "dokument": {
      "type": "object",
      "properties": {
        "aussteller": {
          "type": "string",
          "description": "Firmenname des Ausstellers. 'k. A.' wenn im Dokument nicht genannt."
        },
        "ort_aussteller": {
          "type": "string",
          "description": "Ort des Ausstellers, bei Ausland mit Land in Klammern. 'k. A.' wenn nicht genannt."
        },
        "adressat": {
          "type": "string",
          "description": "Firmenname des Empfängers. 'allgemein' bei Rundschreiben an alle Kunden. 'k. A.' wenn nicht erkennbar."
        },
        "dokumenttyp": {
          "type": "string",
          "enum": [
            "Konformitätserklärung PPWR",
            "Lebensmittel-Konformitätserklärung",
            "Stoff-/PPWR-Statement",
            "Produktspezifikation",
            "allgemeines Anschreiben"
          ]
        },
        "datum": {
          "type": "string",
          "description": "Ausstellungsdatum als JJJJ-MM-TT, JJJJ-MM oder 'k. A.'"
        },
        "gueltig_bis": {
          "type": "string",
          "description": "JJJJ-MM-TT oder 'k. A.'"
        },
        "sprache": {
          "type": "string",
          "enum": [
            "DE",
            "EN",
            "DE/EN"
          ]
        },
        "geltungsbereich": {
          "type": "string",
          "enum": [
            "Artikel",
            "Produktgruppe",
            "alle Produkte",
            "k. A."
          ]
        }
      },
      "required": [
        "aussteller",
        "ort_aussteller",
        "adressat",
        "dokumenttyp",
        "datum",
